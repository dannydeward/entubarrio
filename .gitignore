# Entorno virtual (¡Muy importante! Nunca se sube)
venv/
env/
.venv/

# Archivos de caché de Python
__pycache__/
*.py[cod]
*$py.class

# Base de datos local (para que el servidor cree la suya propia)
db.sqlite3

# Archivos subidos por los usuarios (Imágenes, PDFs, etc.)
media/

# Archivos estáticos recolectados (se generan automáticamente en el servidor)
staticfiles/

# Variables de entorno (Claves secretas, contraseñas)
.env

# Archivos de configuración de editores (VS Code, etc.)
.vscode/
.idea/
*.swp
*.swo